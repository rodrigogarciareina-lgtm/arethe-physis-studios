---
// Layout.astro
const { title = "Arethé Physis Studios" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="From waste to Virtue. By Nature. Upcycled streetwear." />
		<title>{title}</title>
		<!-- Tipografías: Una editorial para títulos, una limpia para textos -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,600&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* Paleta de Arethé Physis Studios */
	:root {
		--turquesa: #6EE5BE;
		--marron: #402211;
		--amarillo: #FFD980;
		--beige: #D9CECA;
		--blanco-roto: #F9F8F6;
		
		--font-display: 'Playfair Display', serif;
		--font-body: 'Inter', sans-serif;
	}

	/* Reset básico minimalista */
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	body {
		background-color: var(--blanco-roto);
		color: var(--marron);
		font-family: var(--font-body);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	h1, h2, h3 {
		font-family: var(--font-display);
		font-weight: 600;
		line-height: 1.1;
	}

	a {
		color: inherit;
		text-decoration: none;
	}
</style>