---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title = "Arethe Physis Studios", theme = "light" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="From waste to Virtue. By Nature. Upcycled streetwear." />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,600&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
		<link rel="icon" type="image/png" href="/favicon.png" />	
	</head>
	<body class={theme}>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--turquesa: #6EE5BE;
		--marron: #402211;
		--amarillo: #FFD980;
		--beige: #D9CECA;
		--blanco-roto: #F9F8F6;
		
		/* CAMBIO AQUÍ: Usamos Amarillo para los títulos grandes */
		--font-display: 'Amarillo', 'Playfair Display', serif; 
		--font-body: 'Inter', sans-serif;
	}

	* { margin: 0; padding: 0; box-sizing: border-box; }

	body {
		background-color: var(--blanco-roto);
		color: var(--marron);
		font-family: var(--font-body);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	main { flex: 1; }
	h1, h2, h3 { font-family: var(--font-display); font-weight: 600; line-height: 1.1; }
	a { color: inherit; text-decoration: none; }

	/* ESTILOS DEL TEMA AMARILLO (Solo para Collection) */
	body.yellow-theme {
		background-color: var(--amarillo);
	}
	
	/* Forzamos al Header y Footer a ser amarillos en este tema */
	body.yellow-theme header {
		background-color: var(--amarillo);
		border-bottom: 1px solid var(--marron);
	}
	
	body.yellow-theme footer {
		background-color: var(--amarillo);
		color: var(--marron);
	}
	
	body.yellow-theme footer .brand {
		color: var(--marron);
	}
	
	body.yellow-theme footer .legal-links a:hover {
		color: var(--blanco-roto);
	}

	/* Cargar fuente Amarillo */
	@font-face {
		font-family: 'Amarillo';
		src: url('/fonts/Amarillo.woff2') format('woff2');
		font-weight: normal;
		font-style: normal;
		font-display: swap;
	}
</style>