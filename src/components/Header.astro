---
// Header.astro
---
<header>
	<a href="/" class="logo">Arethe</a>
	<nav>
		<a href="/collection">Collection</a>
		<a href="/process">Process</a>
		<a href="/impact">Impact</a>
		<a href="/about">About</a>
		<a href="/contact">Contact</a>
		<a href="/cart">Cart</a>
		
		<!-- BOTÓN DE LOGIN -->
		<a href="#" id="auth-trigger" class="login-link">
			<span id="auth-text">Log in</span>
		</a>

		<a href="/customize" class="btn-nav">Customize</a>
	</nav>
</header>

<!-- MODAL DE LOGIN (Oculto por defecto) -->
<div id="auth-modal" class="auth-modal" style="display: none;">
	<div class="auth-content">
		<button id="close-auth" class="close-btn">&times;</button>
		<h2 id="modal-title">Welcome back</h2>
		<p id="modal-desc">Sign in to save your custom designs and track your orders.</p>
		
		<form id="auth-form">
			<div id="form-fields">
				<input type="text" id="user-name" placeholder="Your Name" required />
				<input type="email" id="user-email" placeholder="Email Address" required />
			</div>
			<button type="submit" id="btn-submit-auth" class="btn-auth">Sign In</button>
			<button type="button" id="btn-logout" class="btn-logout" style="display: none;">Log Out</button>
		</form>
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const authTrigger = document.getElementById('auth-trigger');
		const authText = document.getElementById('auth-text');
		const authModal = document.getElementById('auth-modal');
		const closeAuth = document.getElementById('close-auth');
		const authForm = document.getElementById('auth-form');
		const userNameInput = document.getElementById('user-name');
		const userEmailInput = document.getElementById('user-email');
		const formFields = document.getElementById('form-fields');
		const btnSubmitAuth = document.getElementById('btn-submit-auth');
		const btnLogout = document.getElementById('btn-logout');
		const modalTitle = document.getElementById('modal-title');
		const modalDesc = document.getElementById('modal-desc');

		// Comprobar si el usuario ya está logueado
		let currentUser = JSON.parse(localStorage.getItem('arethe_user')) || null;

		function updateUI() {
			if (currentUser) {
				authText.textContent = `Hi, ${currentUser.name.split(' ')[0]}`;
				formFields.style.display = 'none';
				btnSubmitAuth.style.display = 'none';
				btnLogout.style.display = 'block';
				modalTitle.textContent = `Hello, ${currentUser.name}`;
				modalDesc.textContent = `Logged in as ${currentUser.email}`;
			} else {
				authText.textContent = 'Log in';
				formFields.style.display = 'flex';
				btnSubmitAuth.style.display = 'block';
				btnLogout.style.display = 'none';
				modalTitle.textContent = 'Welcome to Arethe';
				modalDesc.textContent = 'Sign in to save your custom designs and track your orders.';
			}
		}

		updateUI();

		// Abrir/Cerrar Modal
		authTrigger.addEventListener('click', (e) => {
			e.preventDefault();
			authModal.style.display = 'flex';
		});

		closeAuth.addEventListener('click', () => {
			authModal.style.display = 'none';
		});

		// Enviar Formulario (Fake Login)
		authForm.addEventListener('submit', (e) => {
			e.preventDefault();
			const name = userNameInput.value;
			const email = userEmailInput.value;
			
			currentUser = { name, email };
			localStorage.setItem('arethe_user', JSON.stringify(currentUser));
			updateUI();
		});

		// Cerrar Sesión
		btnLogout.addEventListener('click', () => {
			currentUser = null;
			localStorage.removeItem('arethe_user');
			updateUI();
			authModal.style.display = 'none';
		});
	});
</script>

<style>
	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.5rem 3rem;
		background-color: var(--blanco-roto);
		border-bottom: 1px solid var(--beige);
		position: sticky;
		top: 0;
		z-index: 100;
	}

	.logo {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.5px;
	}

	nav {
		display: flex;
		gap: 1.5rem;
		align-items: center;
		font-size: 0.9rem;
		font-weight: 400;
	}

	nav a:hover {
		color: var(--turquesa);
		transition: color 0.2s ease;
	}

	.login-link {
		font-weight: 600;
		color: var(--marron);
		opacity: 0.7;
		transition: opacity 0.2s;
	}
	.login-link:hover { opacity: 1; }

	.btn-nav {
		background-color: var(--marron);
		color: var(--blanco-roto);
		padding: 0.5rem 1.2rem;
		border-radius: 2rem;
	}
	.btn-nav:hover {
		background-color: var(--turquesa);
		color: var(--marron);
	}

	/* MODAL AUTH */
	.auth-modal {
		position: fixed;
		top: 0; left: 0; width: 100%; height: 100%;
		background-color: rgba(64, 34, 17, 0.6);
		backdrop-filter: blur(5px);
		display: flex; justify-content: center; align-items: center;
		z-index: 1000;
	}
	.auth-content {
		background-color: var(--blanco-roto);
		padding: 3rem; border-radius: 24px;
		width: 100%; max-width: 400px;
		position: relative;
		text-align: center;
		box-shadow: 0 20px 50px rgba(0,0,0,0.2);
		animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}
	.close-btn {
		position: absolute; top: 1rem; right: 1.5rem;
		background: none; border: none; font-size: 1.5rem;
		color: var(--marron); cursor: pointer; opacity: 0.5;
	}
	.close-btn:hover { opacity: 1; }
	.auth-content h2 { font-family: var(--font-display); font-size: 2rem; margin-bottom: 0.5rem; }
	.auth-content p { font-size: 0.9rem; opacity: 0.6; margin-bottom: 2rem; }
	#form-fields { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem; }
	#form-fields input {
		width: 100%; padding: 1rem; border: 1px solid var(--beige);
		border-radius: 8px; font-family: var(--font-body); font-size: 1rem; background-color: white;
	}
	#form-fields input:focus { outline: none; border-color: var(--turquesa); }
	
	.btn-auth {
		width: 100%; padding: 1rem; background-color: var(--marron); color: white;
		border: none; border-radius: 50px; font-size: 1rem; font-weight: 600; cursor: pointer;
		transition: background 0.3s;
	}
	.btn-auth:hover { background-color: var(--turquesa); color: var(--marron); }
	.btn-logout {
		width: 100%; padding: 1rem; background-color: transparent; color: #d9534f;
		border: 1px solid #d9534f; border-radius: 50px; font-size: 1rem; font-weight: 600; cursor: pointer;
	}

	@keyframes popIn {
		0% { transform: scale(0.95); opacity: 0; }
		100% { transform: scale(1); opacity: 1; }
	}

	@media (max-width: 1024px) {
		nav { gap: 1rem; }
	}
	@media (max-width: 768px) {
		header { padding: 1rem; flex-direction: column; gap: 1rem; }
		nav { flex-wrap: wrap; justify-content: center; gap: 0.8rem; }
	}
</style>