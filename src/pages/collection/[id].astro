---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products.js';

export async function getStaticPaths() {
	return products.map((product) => ({
		params: { id: product.id.toString() },
		props: { product },
	}));
}

const { product } = Astro.props;
---
<Layout title={`${product.title} | Arethe`}>
	<main class="product-detail">
		
		<div class="image-section">
			<img src={product.img} alt={product.title} />
		</div>

		<div class="info-section">
			<a href="/collection" class="back-link">&larr; Back to collection</a>
			<span class="tag">{product.tag}</span>
			<h1>{product.title}</h1>
			<p class="price">{product.price}</p>
			
			<div class="description">
				<p>This exclusive piece was rescued from deadstock and reimagined by our studio. Hand-finished details make this a true one-of-one garment.</p>
				<ul>
					<li><strong>Origin:</strong> Upcycled textile waste</li>
					<li><strong>Technique:</strong> Deconstruction & hand embroidery</li>
					<li><strong>Fit:</strong> Relaxed / Oversized</li>
				</ul>
			</div>

			<div class="actions">
				<a href={`/customize?id=${product.id}`} class="btn-customize">Customize this piece</a>
				<button class="btn-cart" id="add-to-cart-btn" data-id={product.id} data-title={product.title} data-price={product.price} data-img={product.images ? product.images[0] : product.img} data-laurel-cost={product.laurelCost || 0}>Add to cart</button>
			</div>
		</div>

	</main>
	<script>
			document.addEventListener('DOMContentLoaded', () => {
				const btnCart = document.getElementById('add-to-cart-btn');
				if(btnCart) {
					btnCart.addEventListener('click', () => {
						const item = {
							id: btnCart.getAttribute('data-id'),
							title: btnCart.getAttribute('data-title'),
							price: btnCart.getAttribute('data-price'),
							image: btnCart.getAttribute('data-img'),
							isCustom: false,
							laurelCost: parseInt(btnCart.getAttribute('data-laurel-cost')) || 0 // <--- AÑADIR ESTO
						};

						// Guardar en localStorage
						let cart = JSON.parse(localStorage.getItem('arethe_cart')) || [];
						cart.push(item);
						localStorage.setItem('arethe_cart', JSON.stringify(cart));

						// Feedback visual
						btnCart.textContent = 'Added to Cart!';
						btnCart.style.backgroundColor = 'var(--turquesa)';
						btnCart.style.color = 'var(--marron)';
						btnCart.style.borderColor = 'var(--turquesa)';
						
						setTimeout(() => {
							btnCart.textContent = 'Add to cart';
							btnCart.style.backgroundColor = 'transparent';
							btnCart.style.color = 'var(--marron)';
							btnCart.style.borderColor = 'var(--marron)';
						}, 2000);
					});
				}
			});
	</script>
</Layout>

<style>
	.product-detail { display: grid; grid-template-columns: 1.2fr 1fr; min-height: 90vh; background-color: var(--blanco-roto); }
	.image-section { background-color: var(--beige); display: flex; align-items: center; justify-content: center; padding: 4rem; }
	.image-section img { width: 100%; max-width: 600px; height: auto; border-radius: 12px; box-shadow: 0 20px 40px rgba(0,0,0,0.05); }
	.info-section { padding: 6rem 4rem; display: flex; flex-direction: column; justify-content: center; }
	.back-link { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.5; margin-bottom: 3rem; transition: opacity 0.3s; }
	.back-link:hover { opacity: 1; }
	.tag { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1.5px; color: var(--turquesa); margin-bottom: 1rem; }
	h1 { font-size: 3.5rem; line-height: 1.1; margin-bottom: 1rem; }
	.price { font-size: 1.5rem; font-weight: 300; margin-bottom: 3rem; opacity: 0.7; }
	.description { font-size: 1rem; line-height: 1.8; opacity: 0.8; margin-bottom: 4rem; }
	.description ul { margin-top: 1.5rem; padding-left: 1.2rem; }
	.description li { margin-bottom: 0.5rem; }
	.actions { display: flex; flex-direction: column; gap: 1rem; }
	.btn-customize, .btn-cart { padding: 1.2rem; text-align: center; text-transform: uppercase; letter-spacing: 1px; font-size: 0.85rem; font-weight: 600; border-radius: 50px; cursor: pointer; transition: all 0.3s ease; border: none; }
	.btn-customize { background-color: var(--turquesa); color: var(--marron); }
	.btn-customize:hover { background-color: var(--marron); color: var(--turquesa); transform: translateY(-2px); }
	.btn-cart { background-color: transparent; color: var(--marron); border: 1px solid var(--marron); }
	.btn-cart:hover { background-color: var(--marron); color: var(--blanco-roto); }
		/* SELLO DE DESCUENTO */
	.sale-badge {
		position: absolute;
		top: 10%;
		right: -10px;
		background-color: #E53935; /* Color rojo de rebajas */
		color: white;
		padding: 0.4rem 1rem;
		font-family: var(--font-body);
		font-weight: 800;
		font-size: 0.9rem;
		transform: rotate(15deg); /* Inclinación horaria */
		box-shadow: 0 4px 10px rgba(0,0,0,0.3);
		z-index: 15;
		border-radius: 4px;
		letter-spacing: 1px;
	}
	@media (max-width: 900px) {
		.product-detail { grid-template-columns: 1fr; }
		.image-section { padding: 2rem; }
		.info-section { padding: 3rem 1.5rem; }
		h1 { font-size: 2.5rem; }
	}
</style>