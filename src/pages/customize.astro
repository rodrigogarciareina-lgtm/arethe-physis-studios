---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Customize | Arethe Physis Studios">
	<main class="customizer">
		
		<aside class="options-panel">
			<div class="panel-header">
				<h2>Customize</h2>
				<p>Pick a garment, select a patch, and drag to place.</p>
			</div>
			
			<div class="control-group">
				<span class="control-label">00. Garment</span>
				<div class="garment-selector">
					<!-- IDENTIFICADORES: V11 MOCKUPS -->
					<button class="garment-btn active" data-img="[ V11 - T-Shirt Base ]">T-Shirt</button>
					<button class="garment-btn" data-img="[ V11 - Tote Bag Base ]">Tote Bag</button>
					<button class="garment-btn" data-img="[ V11 - Pants Base ]">Pants</button>
				</div>
			</div>

			<div class="control-group">
				<span class="control-label">01. Select Patch</span>
				<div class="patches-grid">
					<!-- IDENTIFICADORES: V10 PATCHES -->
					<button class="patch-option" data-src="[ Patch 01 ]"><span class="patch-text">Patch 01</span></button>
					<button class="patch-option" data-src="[ Patch 02 ]"><span class="patch-text">Patch 02</span></button>
					<button class="patch-option" data-src="[ Patch 03 ]"><span class="patch-text">Patch 03</span></button>
					<button class="patch-option" data-src="[ Patch 04 ]"><span class="patch-text">Patch 04</span></button>
				</div>
			</div>

			<div class="control-group">
				<span class="control-label">02. Quick Snap</span>
				<div class="zones-grid">
					<button class="zone-btn active" data-zone="left">Top Left</button>
					<button class="zone-btn" data-zone="center">Center</button>
					<button class="zone-btn" data-zone="right">Top Right</button>
				</div>
			</div>

			<div class="control-group">
				<span class="control-label">03. Size</span>
				<input type="range" id="size-slider" min="20" max="150" value="60" />
			</div>

			<div class="actions">
				<button id="btn-clear" class="btn-clear">Clear</button>
				<button class="btn-save">Add to Cart</button>
			</div>
		</aside>

		<section class="preview-area">
			<div class="garment-container" id="canvas">
				<!-- IDENTIFICADOR BASE INICIAL -->
				<div id="base-garment" class="garment-img placeholder-bg">
					<span id="base-text">[ V11 - T-Shirt Base ]</span>
				</div>
				<!-- El parche interactivo -->
				<div id="preview-patch" class="preview-patch" style="display: none;">
					<span class="patch-content"></span>
				</div>
			</div>
		</section>

	</main>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const baseGarment = document.getElementById('base-garment');
		const baseText = document.getElementById('base-text');
		const patchOptions = document.querySelectorAll('.patch-option');
		const garmentBtns = document.querySelectorAll('.garment-btn');
		const zoneBtns = document.querySelectorAll('.zone-btn');
		const sizeSlider = document.getElementById('size-slider');
		const previewPatch = document.getElementById('preview-patch');
		const patchContent = previewPatch.querySelector('.patch-content');
		const btnClear = document.getElementById('btn-clear');

		let currentPatchSrc = null;
		let currentSize = 60;

		const zonePositions = {
			left: { left: '35%', top: '35%' },
			center: { left: '50%', top: '45%' },
			right: { left: '65%', top: '35%' }
		};

		function updateSize() {
			previewPatch.style.transform = `translate(-50%, -50%) scale(${currentSize / 60})`;
		}

		function updatePreview() {
			if (!currentPatchSrc) {
				previewPatch.style.display = 'none';
				return;
			}
			previewPatch.style.display = 'block';
			patchContent.textContent = currentPatchSrc;
			updateSize();
		}

		garmentBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				garmentBtns.forEach(b => b.classList.remove('active'));
				btn.classList.add('active');
				baseText.textContent = btn.getAttribute('data-img');
				zoneBtns[1].click(); 
			});
		});

		patchOptions.forEach(btn => {
			btn.addEventListener('click', () => {
				patchOptions.forEach(b => b.classList.remove('selected'));
				btn.classList.add('selected');
				currentPatchSrc = btn.getAttribute('data-src');
				updatePreview();
			});
		});

		zoneBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				zoneBtns.forEach(b => b.classList.remove('active'));
				btn.classList.add('active');
				previewPatch.style.transition = 'top 0.3s ease, left 0.3s ease, transform 0.1s ease';
				const zone = btn.getAttribute('data-zone');
				previewPatch.style.left = zonePositions[zone].left;
				previewPatch.style.top = zonePositions[zone].top;
			});
		});

		sizeSlider.addEventListener('input', (e) => {
			currentSize = e.target.value;
			updateSize();
		});

		let isDragging = false;
		let offsetX = 0;
		let offsetY = 0;

		previewPatch.style.pointerEvents = 'auto';
		previewPatch.style.cursor = 'grab';

		previewPatch.addEventListener('pointerdown', (e) => {
			if (previewPatch.style.display === 'none') return;
			isDragging = true;
			previewPatch.style.cursor = 'grabbing';
			previewPatch.style.transition = 'none';
			zoneBtns.forEach(b => b.classList.remove('active'));

			const patchRect = previewPatch.getBoundingClientRect();
			offsetX = e.clientX - (patchRect.left + patchRect.width / 2);
			offsetY = e.clientY - (patchRect.top + patchRect.height / 2);
			previewPatch.setPointerCapture(e.pointerId);
		});

		previewPatch.addEventListener('pointermove', (e) => {
			if (!isDragging) return;
			const canvasRect = previewPatch.parentElement.getBoundingClientRect();
			const newLeft = e.clientX - canvasRect.left - offsetX;
			const newTop = e.clientY - canvasRect.top - offsetY;
			previewPatch.style.left = `${newLeft}px`;
			previewPatch.style.top = `${newTop}px`;
		});

		previewPatch.addEventListener('pointerup', (e) => {
			isDragging = false;
			previewPatch.style.cursor = 'grab';
			previewPatch.style.transition = 'transform 0.1s ease';
			previewPatch.releasePointerCapture(e.pointerId);
		});

		btnClear.addEventListener('click', () => {
			currentPatchSrc = null;
			patchOptions.forEach(b => b.classList.remove('selected'));
			previewPatch.style.display = 'none';
		});
	});
</script>

<style>
	.customizer { display: grid; grid-template-columns: 350px 1fr; min-height: calc(100vh - 80px); background-color: #F8F9FA; }
	.options-panel { background-color: white; border-right: 1px solid #EAEAEA; padding: 3rem 2rem; display: flex; flex-direction: column; z-index: 10; overflow-y: auto; }
	.panel-header h2 { font-size: 2rem; margin-bottom: 0.5rem; color: var(--marron); }
	.panel-header p { font-size: 0.85rem; color: #888; margin-bottom: 3rem; line-height: 1.5; }
	.control-group { margin-bottom: 2.5rem; }
	.control-label { display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600; color: #AAA; margin-bottom: 1rem; }

	.garment-selector { display: flex; gap: 0.5rem; }
	.garment-btn { flex: 1; padding: 0.8rem 0.5rem; background-color: #F8F9FA; border: 1px solid #EAEAEA; border-radius: 8px; font-size: 0.8rem; font-weight: 600; color: #666; cursor: pointer; transition: all 0.2s; }
	.garment-btn.active { background-color: var(--marron); color: white; border-color: var(--marron); }

	.patches-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.8rem; }
	.patch-option { background-color: #F8F9FA; border: 1px solid transparent; border-radius: 12px; padding: 1rem; cursor: pointer; aspect-ratio: 1/1; transition: all 0.2s; display: flex; justify-content: center; align-items: center; }
	.patch-text { font-size: 0.8rem; font-weight: 600; color: #888; }
	.patch-option:hover { background-color: white; border-color: #EAEAEA; }
	.patch-option.selected { border-color: var(--turquesa); background-color: white; }
	.patch-option.selected .patch-text { color: var(--marron); }

	.zones-grid { display: flex; gap: 0.5rem; }
	.zone-btn { flex: 1; background-color: #F8F9FA; border: 1px solid transparent; padding: 0.6rem; border-radius: 8px; font-size: 0.8rem; color: #666; cursor: pointer; transition: all 0.2s; }
	.zone-btn:hover { background-color: white; border-color: #EAEAEA; }
	.zone-btn.active { background-color: var(--marron); color: white; border-color: var(--marron); }

	input[type=range] { width: 100%; -webkit-appearance: none; background: transparent; }
	input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; height: 20px; width: 20px; border-radius: 50%; background: var(--turquesa); cursor: pointer; margin-top: -8px; box-shadow: 0 2px 5px rgba(0,0,0,0.2); }
	input[type=range]::-webkit-slider-runnable-track { width: 100%; height: 4px; cursor: pointer; background: #EAEAEA; border-radius: 2px; }

	.actions { display: flex; flex-direction: column; gap: 1rem; margin-top: auto; }
	.btn-clear, .btn-save { padding: 1rem; border-radius: 8px; font-size: 0.9rem; font-weight: 600; cursor: pointer; transition: all 0.3s; text-align: center; }
	.btn-clear { background-color: transparent; color: #888; border: 1px solid #EAEAEA; }
	.btn-save { background-color: var(--marron); color: white; border: none; }
	.btn-save:hover { background-color: var(--turquesa); color: var(--marron); }

	.preview-area { display: flex; justify-content: center; align-items: center; padding: 4rem; }
	.garment-container { position: relative; max-width: 500px; width: 100%; border-radius: 20px; box-shadow: 0 30px 60px rgba(0,0,0,0.08); background-color: white; overflow: hidden; }
	
	.placeholder-bg { width: 100%; aspect-ratio: 3/4; background-color: var(--beige); display: flex; justify-content: center; align-items: center; }
	#base-text { font-size: 1rem; font-weight: 600; color: var(--marron); letter-spacing: 1px; text-align: center; }

	.preview-patch {
		position: absolute; width: 80px; height: 80px;
		left: 50%; top: 50%;
		transform: translate(-50%, -50%) scale(1);
		transform-origin: center center; z-index: 10;
		background-color: var(--amarillo);
		border: 2px dashed var(--marron);
		border-radius: 50%;
		display: flex; justify-content: center; align-items: center;
	}
	.patch-content { font-size: 0.7rem; font-weight: 600; color: var(--marron); text-align: center; }
	.preview-patch:hover { cursor: grab; outline: 2px solid var(--turquesa); outline-offset: 4px; }

	@media (max-width: 900px) {
		.customizer { grid-template-columns: 1fr; }
		.options-panel { border-right: none; border-bottom: 1px solid #EAEAEA; padding: 2rem; }
		.preview-area { padding: 2rem; }
	}
</style>