---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Customize | Arethé Physis Studios">
	<main class="customizer">
		
		<!-- Panel Izquierdo: Controles -->
		<aside class="options-panel">
			<div class="panel-header">
				<h2>Customize</h2>
				<p>Pick a garment, select a patch, and drag to place.</p>
			</div>
			
			<!-- Selector de Prenda -->
			<div class="control-group">
				<span class="control-label">00. Garment</span>
				<div class="garment-selector">
					<button class="garment-btn active" data-img="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?q=80&w=800&auto=format&fit=crop">T-Shirt</button>
					<button class="garment-btn" data-img="https://images.unsplash.com/photo-1544816155-12df9643f363?q=80&w=800&auto=format&fit=crop">Tote Bag</button>
					<button class="garment-btn" data-img="https://images.unsplash.com/photo-1584370848010-d7fe6bc767ec?q=80&w=800&auto=format&fit=crop">Pants</button>
				</div>
			</div>

			<!-- Selección de Parche -->
			<div class="control-group">
				<span class="control-label">01. Select Patch</span>
				<div class="patches-grid">
					<button class="patch-option" data-src="https://cdn-icons-png.flaticon.com/512/9317/9317800.png">
						<img src="https://cdn-icons-png.flaticon.com/512/9317/9317800.png" alt="Leaf" />
					</button>
					<button class="patch-option" data-src="https://cdn-icons-png.flaticon.com/512/2457/2457002.png">
						<img src="https://cdn-icons-png.flaticon.com/512/2457/2457002.png" alt="Butterfly" />
					</button>
					<button class="patch-option" data-src="https://cdn-icons-png.flaticon.com/512/616/616494.png">
						<img src="https://cdn-icons-png.flaticon.com/512/616/616494.png" alt="Lightning" />
					</button>
					<button class="patch-option" data-src="https://cdn-icons-png.flaticon.com/512/3464/3464112.png">
						<img src="https://cdn-icons-png.flaticon.com/512/3464/3464112.png" alt="Flower" />
					</button>
				</div>
			</div>

			<!-- Posiciones Rápidas -->
			<div class="control-group">
				<span class="control-label">02. Quick Snap</span>
				<div class="zones-grid">
					<button class="zone-btn active" data-zone="left">Top Left</button>
					<button class="zone-btn" data-zone="center">Center</button>
					<button class="zone-btn" data-zone="right">Top Right</button>
				</div>
			</div>

			<!-- Tamaño -->
			<div class="control-group">
				<span class="control-label">03. Size</span>
				<input type="range" id="size-slider" min="20" max="150" value="60" />
			</div>

			<div class="actions">
				<button id="btn-clear" class="btn-clear">Clear</button>
				<button class="btn-save">Add to Cart</button>
			</div>
		</aside>

		<!-- Panel Central: Lienzo -->
		<section class="preview-area">
			<div class="garment-container" id="canvas">
				<img id="base-garment" src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?q=80&w=800&auto=format&fit=crop" alt="Garment Base" class="garment-img" />
				<img id="preview-patch" class="preview-patch" src="" style="display: none;" />
			</div>
		</section>

	</main>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const canvas = document.getElementById('canvas');
		const baseGarment = document.getElementById('base-garment');
		const patchOptions = document.querySelectorAll('.patch-option');
		const garmentBtns = document.querySelectorAll('.garment-btn');
		const zoneBtns = document.querySelectorAll('.zone-btn');
		const sizeSlider = document.getElementById('size-slider');
		const previewPatch = document.getElementById('preview-patch');
		const btnClear = document.getElementById('btn-clear');

		let currentPatchSrc = null;
		let currentSize = 60;

		// Coordenadas exactas en porcentaje para las posiciones rápidas
		const zonePositions = {
			left: { left: '35%', top: '35%' },
			center: { left: '50%', top: '45%' },
			right: { left: '65%', top: '35%' }
		};

		// 1. Actualizar el tamaño (Usa transform para escalar desde el centro)
		function updateSize() {
			previewPatch.style.transform = `translate(-50%, -50%) scale(${currentSize / 60})`;
		}

		// 2. Mostrar/Actualizar parche
		function updatePreview() {
			if (!currentPatchSrc) {
				previewPatch.style.display = 'none';
				return;
			}
			previewPatch.style.display = 'block';
			previewPatch.src = currentPatchSrc;
			updateSize();
		}

		// 3. Cambiar de prenda
		garmentBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				garmentBtns.forEach(b => b.classList.remove('active'));
				btn.classList.add('active');
				baseGarment.src = btn.getAttribute('data-img');
				// Al cambiar de prenda, reseteamos el parche a la posición central
				zoneBtns[1].click(); 
			});
		});

		// 4. Seleccionar parche
		patchOptions.forEach(btn => {
			btn.addEventListener('click', () => {
				patchOptions.forEach(b => b.classList.remove('selected'));
				btn.classList.add('selected');
				currentPatchSrc = btn.getAttribute('data-src');
				updatePreview();
			});
		});

		// 5. Posiciones rápidas (Snap)
		zoneBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				zoneBtns.forEach(b => b.classList.remove('active'));
				btn.classList.add('active');
				
				// Habilitamos la transición para que se deslice suavemente a su sitio
				previewPatch.style.transition = 'top 0.3s ease, left 0.3s ease, transform 0.1s ease';
				
				const zone = btn.getAttribute('data-zone');
				previewPatch.style.left = zonePositions[zone].left;
				previewPatch.style.top = zonePositions[zone].top;
			});
		});

		// 6. Cambiar tamaño
		sizeSlider.addEventListener('input', (e) => {
			currentSize = e.target.value;
			updateSize();
		});

		// 7. DRAG & DROP PERFECTO (Matemáticas de píxeles absolutos)
		let isDragging = false;
		let offsetX = 0;
		let offsetY = 0;

		previewPatch.style.pointerEvents = 'auto';
		previewPatch.style.cursor = 'grab';

		previewPatch.addEventListener('pointerdown', (e) => {
			if (previewPatch.style.display === 'none') return;
			isDragging = true;
			previewPatch.style.cursor = 'grabbing';
			// Desactivamos transiciones para que el parche pegue al ratón instantáneamente
			previewPatch.style.transition = 'none';
			
			// Quitamos la selección visual de los botones de snap
			zoneBtns.forEach(b => b.classList.remove('active'));

			const patchRect = previewPatch.getBoundingClientRect();
			
			// Calculamos la distancia exacta entre el ratón y el CENTRO del parche
			offsetX = e.clientX - (patchRect.left + patchRect.width / 2);
			offsetY = e.clientY - (patchRect.top + patchRect.height / 2);

			previewPatch.setPointerCapture(e.pointerId);
		});

		previewPatch.addEventListener('pointermove', (e) => {
			if (!isDragging) return;
			
			const canvasRect = canvas.getBoundingClientRect();
			
			// Calculamos la nueva posición en píxeles respecto al lienzo
			const newLeft = e.clientX - canvasRect.left - offsetX;
			const newTop = e.clientY - canvasRect.top - offsetY;
			
			// Aplicamos la posición (el translate del CSS se encarga de centrarlo)
			previewPatch.style.left = `${newLeft}px`;
			previewPatch.style.top = `${newTop}px`;
		});

		previewPatch.addEventListener('pointerup', (e) => {
			isDragging = false;
			previewPatch.style.cursor = 'grab';
			// Reactivamos la transición suave
			previewPatch.style.transition = 'transform 0.1s ease';
			previewPatch.releasePointerCapture(e.pointerId);
		});

		// Limpiar todo
		btnClear.addEventListener('click', () => {
			currentPatchSrc = null;
			patchOptions.forEach(b => b.classList.remove('selected'));
			previewPatch.style.display = 'none';
		});
	});
</script>

<style>
	.customizer {
		display: grid;
		grid-template-columns: 350px 1fr;
		min-height: calc(100vh - 80px);
		background-color: #F8F9FA;
	}

	.options-panel {
		background-color: white;
		border-right: 1px solid #EAEAEA;
		padding: 3rem 2rem;
		display: flex;
		flex-direction: column;
		z-index: 10;
		overflow-y: auto;
	}

	.panel-header h2 { font-size: 2rem; margin-bottom: 0.5rem; color: var(--marron); }
	.panel-header p { font-size: 0.85rem; color: #888; margin-bottom: 3rem; line-height: 1.5; }
	.control-group { margin-bottom: 2.5rem; }

	.control-label {
		display: block;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 1.5px;
		font-weight: 600;
		color: #AAA;
		margin-bottom: 1rem;
	}

	.garment-selector { display: flex; gap: 0.5rem; }
	.garment-btn {
		flex: 1; padding: 0.8rem 0.5rem; background-color: #F8F9FA;
		border: 1px solid #EAEAEA; border-radius: 8px; font-size: 0.8rem;
		font-weight: 600; color: #666; cursor: pointer; transition: all 0.2s;
	}
	.garment-btn.active { background-color: var(--marron); color: white; border-color: var(--marron); }

	.patches-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.8rem; }
	.patch-option {
		background-color: #F8F9FA; border: 1px solid transparent;
		border-radius: 12px; padding: 0.5rem; cursor: pointer; aspect-ratio: 1/1; transition: all 0.2s;
	}
	.patch-option img { width: 100%; height: 100%; object-fit: contain; opacity: 0.7; }
	.patch-option:hover { background-color: white; border-color: #EAEAEA; }
	.patch-option.selected { border-color: var(--turquesa); background-color: white; }
	.patch-option.selected img { opacity: 1; transform: scale(1.1); }

	.zones-grid { display: flex; gap: 0.5rem; }
	.zone-btn {
		flex: 1; background-color: #F8F9FA; border: 1px solid transparent;
		padding: 0.6rem; border-radius: 8px; font-size: 0.8rem; color: #666; cursor: pointer; transition: all 0.2s;
	}
	.zone-btn:hover { background-color: white; border-color: #EAEAEA; }
	.zone-btn.active { background-color: var(--marron); color: white; border-color: var(--marron); }

	input[type=range] { width: 100%; -webkit-appearance: none; background: transparent; }
	input[type=range]::-webkit-slider-thumb {
		-webkit-appearance: none; height: 20px; width: 20px; border-radius: 50%;
		background: var(--turquesa); cursor: pointer; margin-top: -8px; box-shadow: 0 2px 5px rgba(0,0,0,0.2);
	}
	input[type=range]::-webkit-slider-runnable-track { width: 100%; height: 4px; cursor: pointer; background: #EAEAEA; border-radius: 2px; }

	.actions { display: flex; flex-direction: column; gap: 1rem; margin-top: auto; }
	.btn-clear, .btn-save { padding: 1rem; border-radius: 8px; font-size: 0.9rem; font-weight: 600; cursor: pointer; transition: all 0.3s; text-align: center; }
	.btn-clear { background-color: transparent; color: #888; border: 1px solid #EAEAEA; }
	.btn-save { background-color: var(--marron); color: white; border: none; }
	.btn-save:hover { background-color: var(--turquesa); color: var(--marron); }

	.preview-area { display: flex; justify-content: center; align-items: center; padding: 4rem; }

	.garment-container {
		position: relative; max-width: 500px; width: 100%;
		border-radius: 20px; box-shadow: 0 30px 60px rgba(0,0,0,0.08);
		background-color: white; overflow: hidden;
	}

	.garment-img { width: 100%; display: block; pointer-events: none; user-select: none; }

	/* EL PARCHE: Siempre centrado con translate */
	.preview-patch {
		position: absolute;
		width: 60px;
		height: auto;
		left: 50%;  /* Posición inicial */
		top: 50%;
		transform: translate(-50%, -50%) scale(1); /* Centrado perfecto */
		filter: drop-shadow(0 10px 15px rgba(0,0,0,0.25));
		transform-origin: center center;
		z-index: 10;
	}

	.preview-patch:hover {
		outline: 2px dashed var(--turquesa);
		outline-offset: 5px;
	}

	@media (max-width: 900px) {
		.customizer { grid-template-columns: 1fr; }
		.options-panel { border-right: none; border-bottom: 1px solid #EAEAEA; padding: 2rem; }
		.preview-area { padding: 2rem; }
	}
</style>