---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About Us | Arethe Physis Studios">
	<main class="about-page">
		
		<header class="about-header">
			<h1>The Virtue <br/>of <span class="accent">Nature.</span></h1>
			<p>Arethe Physis Studios is not just a brand. It's a rebellion against the disposable culture of fast fashion.</p>
		</header>

		<section class="manifesto-section">
			<div class="manifesto-text">
				<span class="label">Our Philosophy</span>
				<h2>Where does the name come from?</h2>
				<p><strong>Arethe (Areté)</strong> is an ancient Greek concept meaning "excellence" or "virtue of the highest kind". <strong>Physis</strong> means "nature".</p>
				<p>We believe that true excellence is found in nature. By rescuing textile waste and turning it into exclusive streetwear, we honor the materials and the planet.</p>
			</div>
			<div class="decorative-blob turquoise-blob"></div>
		</section>

		<section class="team-section">
			<div class="team-header">
				<h2>The Minds Behind the Magic</h2>
				<p>A multidisciplinary team of creatives, strategists, and tech enthusiasts.</p>
			</div>

			<div class="team-grid">
				<div class="team-member">
					<div class="member-photo beige-blob">[ V8 - Rodrigo Photo ]</div>
					<h3>Rodrigo</h3>
					<span>Project Manager & Tech</span>
				</div>
				<div class="team-member">
					<div class="member-photo yellow-blob">[ V8 - Romina Photo ]</div>
					<h3>Romina</h3>
					<span>Writing & Business Strategy</span>
				</div>
				<div class="team-member">
					<div class="member-photo turquoise-blob">[ V8 - Fatma Photo ]</div>
					<h3>Fatma</h3>
					<span>Creative Director & Design</span>
				</div>
			</div>
		</section>

		<section class="about-cta">
			<h2>Be part of the change.</h2>
			<a href="/collection" class="btn">Shop the collection</a>
		</section>

	</main>
</Layout>

<style>
	.about-page { background-color: var(--blanco-roto); min-height: 100vh; overflow: hidden; }
	.about-header { text-align: center; padding: 10rem 2rem 8rem; max-width: 900px; margin: 0 auto; }
	.about-header h1 { font-size: 6rem; line-height: 1; letter-spacing: -3px; margin-bottom: 2rem; }
	.accent { font-style: italic; color: var(--turquesa); }
	.about-header p { font-size: 1.4rem; opacity: 0.7; line-height: 1.6; max-width: 700px; margin: 0 auto; }

	.manifesto-section { display: grid; grid-template-columns: 1fr 1fr; align-items: center; max-width: 1200px; margin: 0 auto; padding: 4rem 2rem; gap: 4rem; }
	.manifesto-text { z-index: 2; }
	.label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 2px; font-weight: 600; color: var(--marron); opacity: 0.5; margin-bottom: 1.5rem; display: block; }
	.manifesto-text h2 { font-size: 3rem; margin-bottom: 2rem; line-height: 1.1; }
	.manifesto-text p { font-size: 1.1rem; line-height: 1.8; opacity: 0.8; margin-bottom: 1.5rem; }

	.decorative-blob { width: 400px; height: 400px; justify-self: center; border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; animation: morph 10s ease-in-out infinite alternate; opacity: 0.8; }

	.team-section { padding: 8rem 2rem; background-color: var(--marron); color: var(--blanco-roto); margin-top: 6rem; border-radius: 50% 50% 0 0 / 5% 5% 0 0; }
	.team-header { text-align: center; margin-bottom: 6rem; }
	.team-header h2 { font-size: 3.5rem; margin-bottom: 1rem; color: var(--amarillo); }
	.team-header p { font-size: 1.1rem; opacity: 0.7; }

	.team-grid { display: flex; justify-content: center; gap: 4rem; max-width: 1000px; margin: 0 auto; flex-wrap: wrap; }
	.team-member { text-align: center; display: flex; flex-direction: column; align-items: center; }
	
	.member-photo {
		width: 200px; height: 200px; margin-bottom: 1.5rem; border-radius: 50%;
		transition: transform 0.4s ease;
		display: flex; justify-content: center; align-items: center;
		font-size: 0.8rem; font-weight: 600; color: var(--marron); text-align: center; padding: 1rem;
	}

	.team-member:hover .member-photo { transform: scale(1.05) rotate(5deg); border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; }
	.team-member h3 { font-size: 1.5rem; margin-bottom: 0.5rem; color: var(--blanco-roto); }
	.team-member span { font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.6; }

	.beige-blob { background-color: var(--beige); }
	.turquoise-blob { background-color: var(--turquesa); }
	.yellow-blob { background-color: var(--amarillo); }

	@keyframes morph {
		0% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; }
		100% { border-radius: 60% 40% 30% 70% / 50% 60% 40% 50%; }
	}

	.about-cta { padding: 8rem 2rem; text-align: center; background-color: var(--blanco-roto); }
	.about-cta h2 { font-size: 3rem; margin-bottom: 2rem; font-style: italic; }
	.btn { display: inline-block; background-color: var(--marron); color: var(--blanco-roto); padding: 1.2rem 3rem; border-radius: 50px; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; transition: all 0.3s; }
	.btn:hover { background-color: var(--turquesa); color: var(--marron); transform: translateY(-3px); }

	@media (max-width: 900px) {
		.about-header h1 { font-size: 4rem; }
		.manifesto-section { grid-template-columns: 1fr; text-align: center; }
		.decorative-blob { width: 250px; height: 250px; }
		.team-grid { gap: 3rem; }
		.team-section { border-radius: 50% 50% 0 0 / 2% 2% 0 0; }
	}
</style>