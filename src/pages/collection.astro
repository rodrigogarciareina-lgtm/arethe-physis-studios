---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products.js';
---
<Layout title="Collection | Arethe Physis Studios" theme="yellow-theme">
	<main class="collection-page">
		
		<header class="page-header">
			<h1>The <span class="accent">Collection</span></h1>
			<p>Exclusive, one-of-one upcycled pieces. Once it's gone, it's gone forever.</p>
		</header>

		<section class="product-grid">
			{products.map((product) => (
				<a href={`/collection/${product.id}`} class="product-card" data-vip={product.vip} data-laurel-cost={product.laurelCost || 0} data-id={product.id}>
					
					<div class="card-visual">
						{product.images ? (
							product.images.map((img, index) => (
								<div class={`bubble animated anim-${index}`}>
									{img.startsWith('[') ? (
										<div class="placeholder-text">{img}</div>
									) : (
										<img src={img} alt={product.title} />
									)}
									<span class="tag">{product.tag}</span>
								</div>
							))
						) : (
							<div class="bubble static">
								{product.img.startsWith('[') ? (
									<div class="placeholder-text">{product.img}</div>
								) : (
									<img src={product.img} alt={product.title} />
								)}
								<span class="tag">{product.tag}</span>
							</div>
						)}

						<!-- SELLO DE DESCUENTO (AHORA ESTÁ FUERA DE LA BURBUJA) -->
						{product.discount && (
							<div class="sale-badge">-{product.discount}%</div>
						)}

						{product.vip && (
							<div class="vip-laurel-tag">{product.laurelCost} 🌿</div>
						)}
						{product.vip && (
							<div class="vip-lock-overlay" style="display: none;">
								<div class="lock-icon">🔒</div>
								<span class="lock-text">Requires {product.laurelCost} Laurels 🌿</span>
							</div>
						)}
					</div>
					
					<div class="product-info">
						<h2>{product.title}</h2>
						{product.vip ? (
							<p class="price" style="color: #2E8B57; font-weight: 700;">Redeem with {product.laurelCost} 🌿</p>
						) : (
							<p class="price">{product.price}</p>
						)}
					</div>
				</a>
			))}
		</section>

	</main>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const currentUser = JSON.parse(localStorage.getItem('arethe_user'));
		const vipCards = document.querySelectorAll('.product-card[data-vip="true"]');
		const userLaurels = (currentUser && currentUser.laurels !== undefined) ? currentUser.laurels : 0;

		vipCards.forEach(card => {
			const laurelCost = parseInt(card.getAttribute('data-laurel-cost'));
			const overlay = card.querySelector('.vip-lock-overlay');
			const visual = card.querySelector('.card-visual');

			if (userLaurels < laurelCost) {
				overlay.style.display = 'flex';
				visual.style.filter = 'blur(8px) grayscale(50%)';
				card.style.cursor = 'not-allowed';
				
				card.addEventListener('click', (e) => {
					e.preventDefault();
					alert(`This is a VIP item. You need ${laurelCost} Laurels 🌿 to unlock it. You currently have ${userLaurels}.`);
				});
			}
		});
	});
</script>

<style>
	.collection-page { padding: 6rem 5%; background-color: var(--amarillo); min-height: 100vh; }
	.page-header { text-align: center; margin-bottom: 6rem; }
	.page-header h1 { font-size: 4rem; margin-bottom: 1rem; letter-spacing: -2px; color: var(--marron); }
	.accent { font-style: italic; color: var(--blanco-roto); text-shadow: 1px 1px 0px var(--marron); }
	.page-header p { font-size: 1rem; color: var(--marron); opacity: 0.8; max-width: 500px; margin: 0 auto; }
	.product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 5rem 3rem; justify-items: center; }
	.product-card { display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 260px; text-decoration: none; }
	.card-visual { position: relative; width: 100%; aspect-ratio: 1 / 1; margin-bottom: 1.5rem; transition: filter 0.3s ease; }
	.bubble { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; overflow: hidden; background-color: var(--beige); transition: border-radius 0.4s ease, box-shadow 0.4s ease; }
	.bubble img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
	.placeholder-text { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; font-family: var(--font-body); font-size: 0.8rem; font-weight: 600; color: var(--marron); text-align: center; padding: 1rem; }
	.bubble.static { animation: breathe 6s ease-in-out infinite alternate; }
	.bubble.animated { animation-duration: 10s; animation-iteration-count: infinite; animation-timing-function: ease-in-out; }
	.bubble.animated.anim-0 { animation-name: syncCycleA, breathe; }
	.bubble.animated.anim-1 { animation-name: syncCycleB, breathe; }
	.product-card:hover .bubble.animated { animation-play-state: paused; }
	.product-card:hover .bubble { border-radius: 50%; box-shadow: 0 15px 30px rgba(64, 34, 17, 0.2); }
	.tag { position: absolute; top: 15%; left: 15%; background-color: var(--marron); color: var(--blanco-roto); padding: 0.3rem 0.8rem; border-radius: 50px; font-size: 0.65rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; z-index: 10; }

	/* SELLO DE DESCUENTO */
	.sale-badge {
		position: absolute;
		top: 10%;
		right: -10px;
		background-color: #E53935;
		color: white;
		padding: 0.4rem 1rem;
		font-family: var(--font-body);
		font-weight: 800;
		font-size: 0.9rem;
		transform: rotate(15deg);
		box-shadow: 0 4px 10px rgba(0,0,0,0.3);
		z-index: 15;
		border-radius: 10px;
		letter-spacing: 1px;
	}

	.vip-laurel-tag { position: absolute; bottom: 10%; right: 10%; background-color: var(--turquesa); color: var(--marron); padding: 0.4rem 0.8rem; border-radius: 50px; font-family: var(--font-body); font-weight: 700; font-size: 0.9rem; z-index: 15; box-shadow: 0 4px 10px rgba(0,0,0,0.2); border: 2px solid var(--marron); }
	.vip-lock-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 20; background: rgba(64, 34, 17, 0.2); border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; color: white; text-align: center; padding: 1rem; }
	.lock-icon { font-size: 3rem; margin-bottom: 0.5rem; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.5)); }
	.lock-text { font-family: var(--font-body); font-weight: 700; font-size: 0.9rem; color: var(--blanco-roto); text-shadow: 0 2px 4px rgba(0,0,0,0.8); background: var(--marron); padding: 0.5rem 1rem; border-radius: 50px; }

	.product-info { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.2rem; }
	.product-info h2 { font-size: 0.95rem; font-family: var(--font-body); font-weight: 500; color: var(--marron); transition: color 0.3s ease; line-height: 1.3; }
	.product-card:hover .product-info h2 { color: var(--blanco-roto); }
	.price { font-weight: 600; font-size: 0.85rem; color: var(--marron); opacity: 0.7; }

	@keyframes breathe { 0% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; } 100% { border-radius: 60% 40% 30% 70% / 50% 60% 40% 50%; } }
	@keyframes syncCycleA { 0%, 45% { opacity: 1; transform: scale(1); } 50%, 95% { opacity: 0; transform: scale(0.2); } 100% { opacity: 1; transform: scale(1); } }
	@keyframes syncCycleB { 0%, 45% { opacity: 0; transform: scale(0.2); } 50%, 95% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(0.2); } }
	@media (max-width: 768px) { .collection-page { padding: 4rem 1.5rem; } .page-header h1 { font-size: 3rem; } .product-grid { grid-template-columns: repeat(2, 1fr); gap: 3rem 1rem; } }
</style>