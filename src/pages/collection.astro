---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products.js';
---
<Layout title="Collection | Arethé Physis Studios">
	<main class="collection-page">
		
		<header class="page-header">
			<h1>The <span class="accent">Collection</span></h1>
			<p>Exclusive, one-of-one upcycled pieces. Once it's gone, it's gone forever.</p>
		</header>

		<section class="product-grid">
			{products.map((product) => (
				<a href={`/collection/${product.id}`} class="product-card">
					
					<div class="card-visual">
						{product.images ? (
							product.images.map((img, index) => (
								<div class={`bubble animated anim-${index}`}>
									<img src={img} alt={product.title} />
									<span class="tag">{product.tag}</span>
								</div>
							))
						) : (
							<div class="bubble static">
								<img src={product.img} alt={product.title} />
								<span class="tag">{product.tag}</span>
							</div>
						)}
					</div>
					
					<div class="product-info">
						<h2>{product.title}</h2>
						<p class="price">{product.price}</p>
					</div>
				</a>
			))}
		</section>

	</main>
</Layout>

<style>
	/* FONDO AMARILLO PARA TODA LA PÁGINA */
	.collection-page {
		padding: 6rem 5%;
		background-color: var(--amarillo); /* El amarillo de la marca */
		min-height: 100vh;
	}

	.page-header {
		text-align: center;
		margin-bottom: 6rem;
	}

	.page-header h1 {
		font-size: 4rem;
		margin-bottom: 1rem;
		letter-spacing: -2px;
		color: var(--marron);
	}

	.accent {
		font-style: italic;
		color: var(--blanco-roto); /* Blanco para que resalte sobre el amarillo */
		text-shadow: 1px 1px 0px var(--marron); /* Un toque de sombra para el contraste */
	}

	.page-header p {
		font-size: 1rem;
		color: var(--marron);
		opacity: 0.8;
		max-width: 500px;
		margin: 0 auto;
	}

	.product-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 5rem 3rem;
		justify-items: center;
	}

	.product-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		max-width: 260px;
	}

	.card-visual {
		position: relative;
		width: 100%;
		aspect-ratio: 1 / 1;
		margin-bottom: 1.5rem;
	}

	/* BURBUJA BASE */
	.bubble {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
		overflow: hidden;
		background-color: var(--beige);
		/* Transiciones para el hover */
		transition: border-radius 0.4s ease, box-shadow 0.4s ease;
	}

	.bubble img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	/* ESTÁTICAS */
	.bubble.static {
		animation: breathe 6s ease-in-out infinite alternate;
	}

	/* ANIMADAS (Cruce exagerado y respiración) */
	/* Asignamos DOS animaciones separadas por coma: el ciclo y la respiración */
		.bubble.animated {
		animation-duration: 10s; /* Ahora tarda 5s en mostrarse cada foto */
		animation-iteration-count: infinite;
		animation-timing-function: ease-in-out;
	}

	/* Imagen 1 */
	.bubble.animated.anim-0 {
		animation-name: syncCycleA, breathe;
	}

	/* Imagen 2 */
	.bubble.animated.anim-1 {
		animation-name: syncCycleB, breathe;
	}

	/* EFECTO HOVER: Pausa y círculo */
	.product-card:hover .bubble.animated {
		animation-play-state: paused;
	}

	.product-card:hover .bubble {
		border-radius: 50%;
		box-shadow: 0 15px 30px rgba(64, 34, 17, 0.2); /* Sombra más fuerte para el amarillo */
	}

	.tag {
		position: absolute;
		top: 15%;
		left: 15%;
		background-color: var(--marron); /* Etiqueta marrón para contrastar con amarillo */
		color: var(--blanco-roto);
		padding: 0.3rem 0.8rem;
		border-radius: 50px;
		font-size: 0.65rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 1px;
		z-index: 10;
	}

	/* ANIMACIONES */
	@keyframes breathe {
		0% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; }
		100% { border-radius: 60% 40% 30% 70% / 50% 60% 40% 50%; }
	}

	/* Imagen A: Visible del 0 al 45%. Desaparece de golpe al 50%. Vuelve al 100%. */
	@keyframes syncCycleA {
		0%, 45% { opacity: 1; transform: scale(1); }
		50%, 95% { opacity: 0; transform: scale(0.2); } /* Se hace diminuta al irse */
		100% { opacity: 1; transform: scale(1); }
	}

	/* Imagen B: Oculta del 0 al 45%. Aparece de golpe al 50%. Crece. Se va al 100%. */
	@keyframes syncCycleB {
		0%, 45% { opacity: 0; transform: scale(0.2); } /* Espera diminuta */
		50%, 95% { opacity: 1; transform: scale(1); } /* Crece exageradamente al entrar */
		100% { opacity: 0; transform: scale(0.2); }
	}

	/* INFO */
	.product-info {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.2rem;
	}

	.product-info h2 {
		font-size: 0.95rem;
		font-family: var(--font-body);
		font-weight: 500;
		color: var(--marron); /* Texto marrón sobre fondo amarillo */
		transition: color 0.3s ease;
		line-height: 1.3;
	}

	.product-card:hover .product-info h2 { 
		color: var(--blanco-roto); 
	}

	.price {
		font-weight: 600;
		font-size: 0.85rem;
		color: var(--marron);
		opacity: 0.7;
	}

	@media (max-width: 768px) {
		.collection-page { padding: 4rem 1.5rem; }
		.page-header h1 { font-size: 3rem; }
		.product-grid { grid-template-columns: repeat(2, 1fr); gap: 3rem 1rem; }
	}
</style>