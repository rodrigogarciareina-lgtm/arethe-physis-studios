---
// index.astro
import Layout from '../layouts/Layout.astro';
---
<Layout title="Arethé Physis Studios | Home">
	<main style="height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 2rem;">
		
		<h1 style="font-size: 4rem; margin-bottom: 1rem; max-width: 800px;">
			From waste to Virtue.<br/>
			<span style="font-style: italic; color: var(--turquesa);">By Nature.</span>
		</h1>
		
		<p style="font-size: 1.2rem; margin-bottom: 2rem; max-width: 500px;">
			Upcycled streetwear, made one at a time.
		</p>

		<button style="background-color: var(--marron); color: var(--blanco-roto); padding: 1rem 2rem; border: none; border-radius: 4px; font-family: var(--font-body); font-size: 1rem; cursor: pointer; transition: background 0.3s ease;">
			Explore the collection
		</button>

	</main>
</Layout>