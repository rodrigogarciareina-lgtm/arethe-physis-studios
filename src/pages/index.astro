---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Arethé Physis Studios | Home">
	
	<!-- 1. HERO ORGÁNICO -->
	<section class="hero">
		<div class="hero-content">
			<div class="tagline-pill">Est. 2024 — Upcycling Studio</div>
			
			<h1>From waste<br/>to <span class="accent">Virtue.</span></h1>
			<p class="by-nature">By Nature.</p>
			
			<p class="hero-desc">Exclusive streetwear crafted from rescued textiles.<br/>Made one at a time.</p>
			
			<a href="/collection" class="btn">Explore collection</a>
		</div>
		
		<div class="hero-visual">
			<div class="blob-container">
				<!-- IDENTIFICADOR: V6 HERO -->
				<div class="placeholder-img">[ V6 — Hero Image ]</div>
				<span class="floating-badge">100% Upcycled</span>
			</div>
		</div>
	</section>

	<!-- 2. MANIFIESTO (Ondulado) -->
	<section class="manifesto">
		<div class="manifesto-inner">
			<h2>"The virtue<br/>of nature."</h2>
			<p>Fast fashion is broken. We take discarded textiles and deadstock clothing to create exclusive, one-of-one pieces. No two items are the same, because your style shouldn't be either.</p>
		</div>
	</section>

	<!-- 3. PROCESO (Tarjetas flotantes) -->
	<section class="process">
		<div class="step yellow-bg">
			<span class="num">01</span>
			<h3>Source</h3>
			<p>We rescue high-quality second-hand garments and textile waste.</p>
		</div>
		<div class="step turquoise-bg">
			<span class="num">02</span>
			<h3>Transform</h3>
			<p>We deconstruct and redesign, turning waste into modern silhouettes.</p>
		</div>
		<div class="step beige-bg">
			<span class="num">03</span>
			<h3>Personalize</h3>
			<p>Add your custom patches and embroidery to make it uniquely yours.</p>
		</div>
	</section>

</Layout>

<style>
	:root {
		--radius-organic: 40% 60% 70% 30% / 40% 50% 60% 50%;
		--transition-smooth: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.hero {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		min-height: 90vh;
		padding: 0 5%;
		align-items: center;
		background-color: var(--blanco-roto);
		overflow: hidden;
	}
	.hero-content { z-index: 2; }
	.tagline-pill {
		display: inline-block;
		background-color: var(--amarillo);
		color: var(--marron);
		padding: 0.4rem 1rem;
		border-radius: 50px;
		font-family: var(--font-body); /* Fuerza la fuente Inter */
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 1.5px; /* Letras un poco separadas para que respire */
		margin-bottom: 2rem;
	}
	.hero h1 {
		font-size: 6rem;
		margin-bottom: 0.2rem; /* Reducimos el margen porque ahora "By Nature" va debajo */
		line-height: 0.9;
		letter-spacing: -3px;
	}

	/* PROBANDO LA FUENTE AMARILLO EN VIRTUE */
	.accent { 
		font-family: 'Amarillo', cursive; 
		font-style: normal; /* La fuente Amarillo ya es caligráfica */
		color: var(--turquesa);
		font-size: 0.6em; /* Un poco más grande para que destaque */
		letter-spacing: 1.5px;
	}
	
	/* EL NUEVO TEXTO "BY NATURE" */
	.hero .by-nature {
		font-family: var(--font-display);
		font-size: 2.0rem; /* Prueba con 3.5 o 4 para ver cuál te gusta más */
		font-style: italic;
		color: var(--marron);
		margin-bottom: 2.0rem;
		margin-top: 0.8rem; /* Ajusta el espacio entre el h1 y este texto */
		letter-spacing: -1px;
		display: block;
		line-height: 1;
	}

	.hero-desc {
		font-size: 1.1rem;
		margin-bottom: 2.5rem;
		max-width: 350px;
		color: var(--marron);
		opacity: 0.8;
	}
	
	/* Arreglamos el sello para que no se deforme */
	.floating-badge {
		position: absolute;
		bottom: 10%;
		right: 5%;
		background-color: var(--blanco-roto);
		color: var(--marron);
		padding: 1rem 2.5rem;
		border-radius: 50px;
		font-family: var(--font-body); /* Le devolvemos Inter */
		font-weight: 700;
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		box-shadow: 0 10px 30px rgba(0,0,0,0.15);
		transform: rotate(-5deg);
		z-index: 10;
	}
	
	.hero p {
		font-size: 1.1rem;
		margin-bottom: 2.5rem;
		max-width: 350px;
		color: var(--marron);
		opacity: 0.8;
	}
	.btn {
		display: inline-block;
		background-color: var(--marron);
		color: var(--blanco-roto);
		padding: 1.2rem 2.5rem;
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		border-radius: 50px;
		transition: var(--transition-smooth);
	}
	.btn:hover {
		background-color: var(--amarillo);
		color: var(--marron);
		transform: scale(1.05) translateY(-3px);
		box-shadow: 0 10px 20px rgba(64, 34, 17, 0.1);
	}
	
	.hero-visual {
		display: flex;
		justify-content: center;
		align-items: center;
		position: relative;
	}
	.blob-container {
		width: 450px;
		height: 450px;
		border-radius: var(--radius-organic);
		position: relative;
		overflow: hidden;
		animation: morph 8s ease-in-out infinite alternate;
		transition: var(--transition-smooth);
	}
	.blob-container:hover {
		border-radius: 50%;
		transform: scale(1.02);
	}
	/* PLACEHOLDER DE IMAGEN */
	.placeholder-img {
		width: 100%;
		height: 100%;
		background-color: var(--beige);
		display: flex;
		justify-content: center;
		align-items: center;
		font-family: var(--font-body);
		font-weight: 600;
		color: var(--marron);
		font-size: 1rem;
		letter-spacing: 1px;
		text-align: center;
		padding: 2rem;
	}
	
	@keyframes morph {
		0% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; }
		100% { border-radius: 60% 40% 30% 70% / 50% 60% 40% 50%; }
	}

	.manifesto {
		padding: 12rem 10%;
		background-color: var(--marron);
		color: var(--blanco-roto);
		display: flex;
		justify-content: flex-end;
		margin: 3rem 0;
		clip-path: ellipse(150% 100% at 50% 50%);
		animation: wave 10s ease-in-out infinite alternate;
	}
	@keyframes wave {
		0% { clip-path: ellipse(150% 100% at 50% 50%); }
		100% { clip-path: ellipse(150% 100% at 50% 55%); }
	}
	.manifesto-inner { max-width: 600px; text-align: right; }
	.manifesto h2 { font-size: 3.5rem; margin-bottom: 2rem; font-style: italic; font-weight: 400; color: var(--amarillo); line-height: 1.1; }
	.manifesto p { font-size: 1.2rem; opacity: 0.8; line-height: 1.8; }

	.process {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 2rem;
		padding: 8rem 5%;
		background-color: var(--blanco-roto);
	}
	.step {
		flex: 1;
		min-width: 280px;
		max-width: 350px;
		padding: 3rem;
		border-radius: 40px;
		transition: var(--transition-smooth);
		cursor: default;
	}
	.step:hover { transform: translateY(-10px) scale(1.02); }
	.yellow-bg { background-color: var(--amarillo); color: var(--marron); }
	.turquoise-bg { background-color: var(--turquesa); color: var(--marron); margin-top: 3rem; }
	.beige-bg { background-color: var(--beige); color: var(--marron); }
	.step .num { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; display: block; margin-bottom: 2rem; opacity: 0.5; }
	.step h3 { font-size: 1.5rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px; }
	.step p { font-size: 1rem; opacity: 0.9; }

	@media (max-width: 1024px) {
		.hero h1 { font-size: 4.5rem; }
		.blob-container { width: 350px; height: 350px; }
	}
	@media (max-width: 768px) {
		.hero { grid-template-columns: 1fr; text-align: center; padding-top: 4rem; }
		.hero-content { display: flex; flex-direction: column; align-items: center; }
		.hero-visual { margin-top: 3rem; }
		.blob-container { width: 280px; height: 280px; }
		.manifesto { justify-content: center; text-align: center; padding: 8rem 2rem; }
		.manifesto-inner { text-align: center; }
		.manifesto h2 { font-size: 2.5rem; }
		.step { margin-top: 0 !important; }
	}
	@media (max-width: 768px) {
		.hero {
			grid-template-columns: 1fr;
			padding: 4rem 1.5rem;
			text-align: center;
		}
		.hero h1 {
			font-size: 3.5rem;
			letter-spacing: -1px;
		}
		.hero .by-nature {
			font-size: 2.5rem;
		}
		.hero-desc {
			margin: 0 auto 2rem auto;
		}
		.hero-visual {
			margin-top: 3rem;
		}
		.blob-container {
			width: 280px;
			height: 280px;
		}
		/* El manifiesto con forma de ola */
		.manifesto {
			padding: 6rem 1.5rem;
			clip-path: ellipse(180% 100% at 50% 50%);
		}
		.manifesto h2 {
			font-size: 2.5rem;
		}
		/* Las tarjetas del proceso */
		.process {
			flex-direction: column;
			padding: 4rem 1.5rem;
		}
		.step {
			margin-top: 0 !important;
		}
	}
</style>