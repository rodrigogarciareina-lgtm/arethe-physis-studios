---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Arethé Physis Studios | Home">
	
	<!-- 1. HERO ORGÁNICO -->
	<section class="hero">
		<div class="hero-content">
			<div class="tagline-pill">Est. 2024 — Upcycling Studio</div>
			<h1>From waste<br/>to <span class="accent">Virtue.</span></h1>
			<p>Exclusive streetwear crafted from rescued textiles.<br/>Made one at a time. By Nature.</p>
			<a href="/collection" class="btn">Explore collection</a>
		</div>
		
		<div class="hero-visual">
			<div class="blob-placeholder">
				<span class="floating-badge">100% Upcycled</span>
			</div>
		</div>
	</section>

	<!-- 2. MANIFIESTO (Ondulado) -->
	<section class="manifesto">
		<div class="manifesto-inner">
			<h2>"The virtue<br/>of nature."</h2>
			<p>Fast fashion is broken. We take discarded textiles and deadstock clothing to create exclusive, one-of-one pieces. No two items are the same, because your style shouldn't be either.</p>
		</div>
	</section>

	<!-- 3. PROCESO (Tarjetas flotantes) -->
	<section class="process">
		<div class="step yellow-bg">
			<span class="num">01</span>
			<h3>Source</h3>
			<p>We rescue high-quality second-hand garments and textile waste.</p>
		</div>
		<div class="step turquoise-bg">
			<span class="num">02</span>
			<h3>Transform</h3>
			<p>We deconstruct and redesign, turning waste into modern silhouettes.</p>
		</div>
		<div class="step beige-bg">
			<span class="num">03</span>
			<h3>Personalize</h3>
			<p>Add your custom patches and embroidery to make it uniquely yours.</p>
		</div>
	</section>

</Layout>

<style>
	/* VARIABLES EXTRA PARA ESTA PÁGINA */
	:root {
		--radius-organic: 40% 60% 70% 30% / 40% 50% 60% 50%;
		--transition-smooth: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	/* HERO */
	.hero {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		min-height: 90vh;
		padding: 0 5%;
		align-items: center;
		background-color: var(--blanco-roto);
		overflow: hidden;
	}
	.hero-content {
		z-index: 2;
	}
	.tagline-pill {
		display: inline-block;
		background-color: var(--amarillo);
		color: var(--marron);
		padding: 0.4rem 1rem;
		border-radius: 50px;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-bottom: 2rem;
	}
	.hero h1 {
		font-size: 6rem;
		margin-bottom: 1.5rem;
		line-height: 0.9;
		letter-spacing: -3px;
	}
	.accent { font-style: italic; color: var(--turquesa); }
	.hero p {
		font-size: 1.1rem;
		margin-bottom: 2.5rem;
		max-width: 350px;
		color: var(--marron);
		opacity: 0.8;
	}
	
	/* BOTÓN INTERACTIVO */
	.btn {
		display: inline-block;
		background-color: var(--marron);
		color: var(--blanco-roto);
		padding: 1.2rem 2.5rem;
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		border-radius: 50px;
		transition: var(--transition-smooth);
	}
	.btn:hover {
		background-color: var(--amarillo);
		color: var(--marron);
		transform: scale(1.05) translateY(-3px);
		box-shadow: 0 10px 20px rgba(64, 34, 17, 0.1);
	}
	
	/* VISUAL ORGÁNICO (BLOB) */
	.hero-visual {
		display: flex;
		justify-content: center;
		align-items: center;
		position: relative;
	}
	.blob-placeholder {
		width: 450px;
		height: 450px;
		background-color: var(--beige);
		border-radius: var(--radius-organic);
		transition: var(--transition-smooth);
		position: relative;
		display: flex;
		justify-content: center;
		align-items: center;
		animation: morph 8s ease-in-out infinite alternate;
	}
	.blob-placeholder:hover {
		border-radius: 50%;
		background-color: var(--turquesa);
	}
	.floating-badge {
		position: absolute;
		bottom: 10%;
		right: -5%;
		background-color: var(--blanco-roto);
		color: var(--marron);
		padding: 1rem 2rem;
		border-radius: 50px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.2rem;
		box-shadow: 0 10px 30px rgba(0,0,0,0.05);
		transform: rotate(-5deg);
	}

	@keyframes morph {
		0% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; }
		100% { border-radius: 60% 40% 30% 70% / 50% 60% 40% 50%; }
	}

	/* MANIFIESTO (Asimétrico y Ondulado) */
	.manifesto {
		padding: 12rem 10%;
		background-color: var(--marron);
		color: var(--blanco-roto);
		display: flex;
		justify-content: flex-end;
		margin: 3rem 0;
		clip-path: ellipse(150% 100% at 50% 50%);
		animation: wave 10s ease-in-out infinite alternate;
	}

	@keyframes wave {
		0% { clip-path: ellipse(150% 100% at 50% 50%); }
		100% { clip-path: ellipse(150% 100% at 50% 55%); }
	}

	.manifesto-inner {
		max-width: 600px;
		text-align: right;
	}
	
	.manifesto h2 { 
		font-size: 3.5rem; 
		margin-bottom: 2rem; 
		font-style: italic; 
		font-weight: 400; 
		color: var(--amarillo); 
		line-height: 1.1; 
	}
	
	.manifesto p { 
		font-size: 1.2rem; 
		opacity: 0.8; 
		line-height: 1.8; 
	}

	/* PROCESO (Tarjetas redondeadas) */
	.process {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 2rem;
		padding: 8rem 5%;
		background-color: var(--blanco-roto);
	}
	.step {
		flex: 1;
		min-width: 280px;
		max-width: 350px;
		padding: 3rem;
		border-radius: 40px;
		transition: var(--transition-smooth);
		cursor: default;
	}
	.step:hover {
		transform: translateY(-10px) scale(1.02);
	}
	.yellow-bg { background-color: var(--amarillo); color: var(--marron); }
	.turquoise-bg { background-color: var(--turquesa); color: var(--marron); margin-top: 3rem; }
	.beige-bg { background-color: var(--beige); color: var(--marron); }

	.step .num { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; display: block; margin-bottom: 2rem; opacity: 0.5; }
	.step h3 { font-size: 1.5rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px; }
	.step p { font-size: 1rem; opacity: 0.9; }

	/* RESPONSIVE */
	@media (max-width: 1024px) {
		.hero h1 { font-size: 4.5rem; }
		.blob-placeholder { width: 350px; height: 350px; }
	}
	@media (max-width: 768px) {
		.hero { grid-template-columns: 1fr; text-align: center; padding-top: 4rem; }
		.hero-content { display: flex; flex-direction: column; align-items: center; }
		.hero-visual { margin-top: 3rem; }
		.blob-placeholder { width: 280px; height: 280px; }
		.manifesto { justify-content: center; text-align: center; padding: 8rem 2rem; }
		.manifesto-inner { text-align: center; }
		.manifesto h2 { font-size: 2.5rem; }
		.step { margin-top: 0 !important; }
	}
</style>