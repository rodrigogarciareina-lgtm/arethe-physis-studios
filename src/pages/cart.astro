---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Your Cart | Arethe Physis Studios">
	<main class="cart-page">
		
		<header class="cart-header">
			<h1>Your <span class="accent">Cart.</span></h1>
			<p>Exclusive pieces waiting to be worn.</p>
		</header>

		<div class="cart-container">
			<div id="cart-items-container" class="cart-items">
				<div id="empty-cart" class="empty-state">
					<div class="empty-blob beige-blob"></div>
					<h2>Your cart is empty</h2>
					<p>Looks like you haven't added any upcycled magic yet.</p>
					<a href="/collection" class="btn">Explore Collection</a>
				</div>
			</div>

			<aside id="cart-summary" class="cart-summary" style="display: none;">
				<h2>Order Summary</h2>
				<div class="summary-row">
					<span>Subtotal</span>
					<span id="cart-subtotal">€0.00</span>
				</div>

				<div class="summary-row" id="discount-row" style="display: none; color: #d9534f;">
					<span>Birthday Discount (10%) 🎂</span>
					<span id="cart-discount">-€0.00</span>
				</div>

				<div class="summary-row">
					<span>Shipping</span>
					<span>Calculated at checkout</span>
				</div>
				
				<div class="summary-row" style="font-size: 0.85rem; opacity: 0.5; margin-bottom: 0;">
					<span>VAT (21% included)</span>
					<span id="cart-vat">€0.00</span>
				</div>
				
				<div class="summary-row laurels-row">
					<span>Laurels to earn 🌿</span>
					<span id="cart-laurels">0</span>
				</div>

				<hr />
				<div class="summary-row total">
					<span>Total <span style="font-size: 0.8rem; font-weight: 400; opacity: 0.6;">(VAT included)</span></span>
					<span id="cart-total">€0.00</span>
				</div>
				<button id="btn-checkout" class="btn-checkout">Proceed to Checkout</button>
			</aside>
		</div>

		<div id="checkout-modal" class="modal" style="display: none;">
			<div class="modal-content">
				<div class="check-icon">✓</div>
				<h2>Order Confirmed!</h2>
				<p>Thank you for choosing Arethe. You've earned <strong id="modal-laurels" style="color: var(--turquesa);"></strong> Laurels with this purchase!</p>
				<button id="btn-close-modal" class="btn">View My Account</button>
			</div>
		</div>

	</main>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		// 🛑 PEGA TU URL AQUÍ
		const API_URL = "https://script.google.com/macros/s/AKfycbxF9P94S19VemYJfcGZD4rREzdBLlXSM5R-01e8Z-CX9Mrj-LktFeI9gL9hG15PKoPc/exec"; 
		
		const cartItemsContainer = document.getElementById('cart-items-container');
		const emptyCart = document.getElementById('empty-cart');
		const cartSummary = document.getElementById('cart-summary');
		const subtotalEl = document.getElementById('cart-subtotal');
		const totalEl = document.getElementById('cart-total');
		const laurelsEl = document.getElementById('cart-laurels');
		const btnCheckout = document.getElementById('btn-checkout');
		const checkoutModal = document.getElementById('checkout-modal');
		const btnCloseModal = document.getElementById('btn-close-modal');
		const modalLaurels = document.getElementById('modal-laurels');

		let cart = JSON.parse(localStorage.getItem('arethe_cart')) || [];
		let currentUser = JSON.parse(localStorage.getItem('arethe_user')) || null;

		function jsonpRequest(url) {
			return new Promise((resolve, reject) => {
				const callbackName = 'jsonpCallback_' + Math.round(100000 * Math.random());
				window[callbackName] = (data) => {
					delete window[callbackName];
					document.body.removeChild(script);
					resolve(data);
				};
				const script = document.createElement('script');
				script.src = `${url}&callback=${callbackName}`;
				script.onerror = reject;
				document.body.appendChild(script);
			});
		}

		function checkIfBirthday(dateStr) {
			if (!dateStr) return false;
			const parts = dateStr.split(/[-/]/);
			if (parts.length !== 3) return false;
			let month, day;
			if (parts[0].length === 4) {
				if (parseInt(parts[1], 10) > 12) {
					day = parseInt(parts[1], 10); month = parseInt(parts[2], 10);
				} else {
					month = parseInt(parts[1], 10); day = parseInt(parts[2], 10);
				}
			} else {
				day = parseInt(parts[0], 10); month = parseInt(parts[1], 10);
			}
			const today = new Date();
			return (today.getMonth() + 1) === month && today.getDate() === day;
		}

		function renderCart() {
			const existingItems = cartItemsContainer.querySelectorAll('.cart-item');
			existingItems.forEach(item => item.remove());

			if (cart.length === 0) {
				emptyCart.style.display = 'flex';
				cartSummary.style.display = 'none';
				return;
			}

			emptyCart.style.display = 'none';
			cartSummary.style.display = 'block';

			let total = 0;

			cart.forEach((item, index) => {
				let finalPriceNum = 0;
				let oldPriceDisplay = null;

				// 1. Determinar el precio final y el precio antiguo
				if (item.discount) {
					if (item.oldPrice) {
						// Viene del configurador
						finalPriceNum = parseFloat(item.price.replace(/[^0-9.]/g, '')) || 0;
						oldPriceDisplay = item.oldPrice;
					} else {
						// Viene de la colección
						let priceNum = parseFloat(item.price.replace(/[^0-9.]/g, '')) || 0;
						finalPriceNum = priceNum * (1 - (item.discount / 100));
						oldPriceDisplay = item.price;
					}
				} else {
					// Sin descuento
					finalPriceNum = parseFloat(item.price.replace(/[^0-9.]/g, '')) || 0;
				}
				
				total += finalPriceNum;

				const itemEl = document.createElement('div');
				itemEl.classList.add('cart-item');
				
				let imageHTML = '';
				if (item.isCustom) {
					const isRealImage = !item.baseGarment.startsWith('[');
					const baseHTML = isRealImage ? `<img src="${item.baseGarment}" class="mini-base-img" />` : `<div class="mini-base">${item.baseGarment}</div>`;
					imageHTML = `<div class="mini-canvas">${baseHTML}<div class="mini-patch" style="left: ${item.patchLeft}%; top: ${item.patchTop}%; transform: translate(-50%, -50%) scale(${item.patchScale * 0.4});">${item.patchSrc}</div></div>`;
				} else {
					imageHTML = item.image.startsWith('[') ? `<div class="placeholder-mini">${item.image}</div>` : `<img src="${item.image}" />`;
				}

				// 2. Maquetar el HTML del precio
				let priceHTML = '';
				if (item.discount) {
					priceHTML = `
						<div class="price-breakdown">
							<span class="old-price">${oldPriceDisplay}</span>
							<span class="new-price">€${finalPriceNum.toFixed(2)}</span>
						</div>
					`;
				} else {
					priceHTML = item.price === '0€' ? 'VIP Reward 🌿' : item.price;
				}

				// 3. Badge de descuento
				const discountBadge = item.discount 
					? `<span class="discount-badge">🔥 ${item.discount}% OFF</span>` 
					: '';

				itemEl.innerHTML = `
					<div class="item-image">${imageHTML}</div>
					<div class="item-details">
						<h3>${item.title}</h3>
						<p>${item.isCustom ? 'Customized Piece' : 'Upcycled Original'}</p>
						${discountBadge}
						<button class="btn-remove" data-index="${index}" style="margin-top: 0.5rem;">Remove</button>
					</div>
					<div class="item-price">${priceHTML}</div>
				`;

				cartItemsContainer.appendChild(itemEl);
			});

			// 4. Lógica de cumpleaños
			let finalTotal = total;
			const discountRow = document.getElementById('discount-row');
			const discountEl = document.getElementById('cart-discount');

			if (currentUser && currentUser.birthday) {
				if (checkIfBirthday(currentUser.birthday)) {
					const discount = total * 0.10;
					finalTotal = total - discount;
					discountRow.style.display = 'flex';
					discountEl.textContent = `-€${discount.toFixed(2)}`;
				} else {
					discountRow.style.display = 'none';
				}
			}

			// 5. Actualizar totales y VAT
			subtotalEl.textContent = `€${total.toFixed(2)}`;
			totalEl.textContent = `€${finalTotal.toFixed(2)}`;
			
			const vatAmount = finalTotal - (finalTotal / 1.21);
			document.getElementById('cart-vat').textContent = `€${vatAmount.toFixed(2)}`;
			
			const laurelsToEarn = Math.floor(finalTotal * 10);
			laurelsEl.textContent = `${laurelsToEarn} 🌿`;

			// 6. Eventos para eliminar
			document.querySelectorAll('.btn-remove').forEach(btn => {
				btn.addEventListener('click', (e) => {
					const index = e.target.getAttribute('data-index');
					cart.splice(index, 1);
					localStorage.setItem('arethe_cart', JSON.stringify(cart));
					renderCart();
				});
			});
		}

		renderCart();

		btnCheckout.addEventListener('click', async () => {
			if (!currentUser) {
				alert("Please log in to complete your purchase and earn Laurels!");
				return;
			}

			btnCheckout.textContent = 'Processing...';
			btnCheckout.disabled = true;
			
			let total = 0;
			cart.forEach(item => { 
				let priceNum = parseFloat(item.price.replace(/[^0-9.]/g, '')) || 0;
				if (item.discount && !item.oldPrice) priceNum = priceNum * (1 - (item.discount / 100));
				total += priceNum; 
			});
			
			let finalTotal = total;
			if (currentUser && currentUser.birthday && checkIfBirthday(currentUser.birthday)) {
				finalTotal = total * 0.90;
			}

			const itemsString = cart.map(item => `${item.title} (${item.price})`).join(' | ');
			const url = `${API_URL}?action=create_order&email=${currentUser.email}&total=${finalTotal}&items=${encodeURIComponent(itemsString)}`;

			try {
				const data = await jsonpRequest(url);
				
				if (data.status === 'success') {
					currentUser.laurels += data.laurelsEarned;
					currentUser.ordersCount += 1;
					localStorage.setItem('arethe_user', JSON.stringify(currentUser));
					
					modalLaurels.textContent = `${data.laurelsEarned} 🌿`;
					checkoutModal.style.display = 'flex';
					
					localStorage.removeItem('arethe_cart');
					cart = [];
					renderCart();
				} else {
					alert("Error al procesar el pedido.");
				}
			} catch (error) {
				console.error("Error", error);
				alert("Connection error. Please try again.");
			} finally {
				btnCheckout.textContent = 'Proceed to Checkout';
				btnCheckout.disabled = false;
			}
		});

		btnCloseModal.addEventListener('click', () => {
			window.location.href = '/account';
		});
	});
</script>

<style is:global>
	.cart-page { background-color: var(--blanco-roto); min-height: 100vh; padding: 8rem 5% 6rem; }
	.cart-header { text-align: center; margin-bottom: 5rem; }
	.cart-header h1 { font-size: 4rem; letter-spacing: -2px; }
	.cart-page .accent { font-style: italic; color: var(--turquesa); }
	.cart-header p { opacity: 0.7; margin-top: 0.5rem; }
	.cart-container { display: grid; grid-template-columns: 1.5fr 1fr; gap: 5rem; max-width: 1100px; margin: 0 auto; align-items: start; }
	.empty-state { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 4rem 0; }
	.empty-blob { width: 150px; height: 150px; border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; background-color: var(--beige); margin-bottom: 2rem; animation: morph 8s ease-in-out infinite alternate; }
	.empty-state h2 { font-size: 2rem; margin-bottom: 1rem; }
	.empty-state p { opacity: 0.6; margin-bottom: 2rem; }
	.cart-items { display: flex; flex-direction: column; gap: 1.5rem; }
	.cart-item { display: grid; grid-template-columns: 120px 1fr auto; gap: 2rem; align-items: center; background-color: white; padding: 1.5rem; border-radius: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); border: 1px solid rgba(0,0,0,0.02); }
	.item-image { width: 120px; height: 120px; border-radius: 16px; overflow: hidden; background-color: var(--beige); }
	.item-image img { width: 100%; height: 100%; object-fit: cover; }
	.placeholder-mini { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 600; text-align: center; padding: 1rem; color: var(--marron); opacity: 0.6; }
	.item-details h3 { font-size: 1.3rem; font-family: var(--font-display); margin-bottom: 0.3rem; }
	.item-details p { font-size: 0.85rem; opacity: 0.5; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px; }
	.btn-remove { background: none; border: none; color: var(--marron); opacity: 0.4; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; padding: 0; text-decoration: underline; }
	.btn-remove:hover { opacity: 1; color: #d9534f; }
	.item-price { font-weight: 600; font-size: 1.2rem; color: var(--marron); }
	.cart-summary { background-color: white; padding: 3rem; border-radius: 24px; box-shadow: 0 20px 50px rgba(0,0,0,0.05); position: sticky; top: 100px; }
	.cart-summary h2 { font-size: 1.5rem; margin-bottom: 2rem; font-family: var(--font-display); }
	.summary-row { display: flex; justify-content: space-between; margin-bottom: 1.2rem; font-size: 0.95rem; opacity: 0.7; }
	.laurels-row { color: #2E8B57; opacity: 1; font-weight: 600; background-color: #f0fdf4; padding: 0.8rem; border-radius: 8px; margin: 1rem 0; }
	.summary-row.total { font-size: 1.4rem; font-weight: 600; opacity: 1; margin-top: 1.5rem; font-family: var(--font-display); }
	hr { border: none; border-top: 1px solid var(--beige); margin: 1.5rem 0; }
	.btn-checkout { width: 100%; background-color: var(--marron); color: white; padding: 1.2rem; border: none; border-radius: 50px; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; cursor: pointer; margin-top: 2rem; transition: all 0.3s ease; box-shadow: 0 10px 20px rgba(64, 34, 17, 0.2); }
	.btn-checkout:hover { background-color: var(--turquesa); color: var(--marron); transform: translateY(-2px); }
	.modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(64, 34, 17, 0.7); backdrop-filter: blur(8px); display: flex; justify-content: center; align-items: center; z-index: 1000; }
	.modal-content { background-color: var(--blanco-roto); padding: 4rem; border-radius: 30px; text-align: center; max-width: 500px; animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
	.check-icon { width: 70px; height: 70px; background-color: var(--turquesa); color: var(--marron); border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 2rem; font-weight: bold; margin: 0 auto 1.5rem; }
	.modal-content h2 { font-size: 2.2rem; margin-bottom: 1rem; font-family: var(--font-display); }
	.modal-content p { opacity: 0.7; margin-bottom: 2rem; line-height: 1.6; }
	.btn { display: inline-block; background-color: var(--marron); color: var(--blanco-roto); padding: 1rem 2.5rem; border-radius: 50px; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; border: none; cursor: pointer; transition: all 0.3s; }
	.btn:hover { background-color: var(--turquesa); color: var(--marron); }

	/* DESGLOSE DE PRECIOS EN LAS TARJETAS */
	.price-breakdown { display: flex; flex-direction: column; align-items: flex-end; gap: 0.2rem; }
	.old-price { text-decoration: line-through; font-size: 0.85rem; opacity: 0.5; }
	.new-price { font-weight: 700; color: var(--marron); font-size: 1.2rem; }
	.discount-badge { display: inline-block; background-color: #FFEBEE; color: #E53935; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; margin-top: 0.5rem; letter-spacing: 0.5px; }

	@keyframes morph { 0% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; } 100% { border-radius: 60% 40% 30% 70% / 50% 60% 40% 50%; } }
	@keyframes popIn { 0% { transform: scale(0.9); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
	@media (max-width: 900px) {
		.cart-container { grid-template-columns: 1fr; gap: 3rem; }
		.cart-item { grid-template-columns: 80px 1fr; gap: 1rem; padding: 1rem; }
		.item-image { width: 80px; height: 80px; }
		.item-price { grid-column: 2; font-size: 1rem; }
		.cart-summary { position: static; padding: 2rem; }
	}
	@media (max-width: 600px) {
		.cart-page { padding: 4rem 1rem; }
		.cart-header h1 { font-size: 2.5rem; }
		.cart-item { grid-template-columns: 1fr; text-align: center; }
		.item-image { width: 100px; height: 100px; margin: 0 auto; }
		.item-price { margin-top: 1rem; text-align: center; justify-content: center; }
		.btn-remove { margin: 0 auto; display: block; }
		.btn-checkout { font-size: 0.8rem; padding: 1rem; }
	}
</style>